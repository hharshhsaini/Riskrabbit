# Copy to backend/.env and replace the placeholder values.
# Never commit backend/.env.

# Neon pooled connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# GitHub token with NO write access. Fine-grained, "Public Repositories (read-only)".
# Authentication alone raises the rate limit to 5,000/hr; no scopes are needed.
GITHUB_TOKEN=github_pat_replace_me

# LLM provider for explanations. Any OpenAI-compatible API works through the
# openai library. Currently Groq (free tier): key from console.groq.com.
# For OpenAI itself, delete OPENAI_BASE_URL and set LLM_MODEL to an OpenAI model.
OPENAI_API_KEY=gsk_replace_me
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Needed for reasoning models such as gpt-oss: without it the hidden reasoning uses
# the whole token budget and the reply comes back empty. Leave empty for models
# like gpt-4o-mini, which reject the parameter.
LLM_REASONING_EFFORT=low

# Path to the trained XGBoost artifact, relative to backend/
MODEL_PATH=ml/model.json

# Seeded single user
DEFAULT_USER_EMAIL=dev@example.com

# development | production
ENV=development
