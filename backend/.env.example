# Copy to backend/.env and replace the placeholder values.
# Never commit backend/.env.

# Neon pooled connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# GitHub personal access token (classic) with the public_repo scope
GITHUB_TOKEN=ghp_replace_me

# OpenAI API key
OPENAI_API_KEY=sk-replace-me

# Path to the trained XGBoost artifact, relative to backend/
MODEL_PATH=ml/model.json

# Seeded single user
DEFAULT_USER_EMAIL=dev@example.com

# development | production
ENV=development
